# Supabase project URL (public; required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (public; required; RLS must be enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Supabase service-role key (server-only; required; never expose to browsers)
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Canonical application URL used for authentication redirects (required)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional MapLibre style URL; defaults to OpenFreeMap Liberty
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
